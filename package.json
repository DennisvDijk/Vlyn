{
  "name": "vlyn",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A measurement instrument for trust in coding agents: runs an existing agent in a worktree and returns a verdict plus a probability checked against held-out tests.",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "vlyn": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/cli.ts"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "vlyn": "node src/cli.ts",
    "rehearse": "node src/cli.ts",
    "demo": "node src/cli.ts run examples/payments",
    "check": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "node --test test/*.test.ts",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.ts test/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  }
}
